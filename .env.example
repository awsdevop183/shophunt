# ============================================================================
# ShopHunt — environment configuration
# Copy to `.env` before running `docker compose up`.
# ============================================================================
# ⚠️  INTENTIONALLY VULNERABLE TRAINING TARGET. Isolated lab use only.
#     Never expose on the public internet or run on a production/cloud server
#     without blocking access to the real cloud metadata service. See README.
# ============================================================================

# --- Database ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root-lab-only
MYSQL_DATABASE=shophunt
MYSQL_USER=shophunt
MYSQL_PASSWORD=shophunt-lab-only
DB_HOST=db
DB_PORT=3306

# --- Backend API ------------------------------------------------------------
BACKEND_PORT=4000

# JWT secret. NOTE: this is deliberately weak/guessable for the JWT lab.
# In a real product this would be a long random value from a secret manager.
JWT_SECRET=secret

# --- Instructor mode --------------------------------------------------------
# OFF by default. When "on", a hidden, separate answer-key surface is exposed
# at the secret path below (student UI is unaffected). Keep OFF for classes.
INSTRUCTOR_MODE=off
# Secret URL segment for instructor endpoints (change per class if you like).
INSTRUCTOR_PATH_TOKEN=change-me-instructor-2f9c

# --- Mock metadata / SSRF lab ----------------------------------------------
# Address the SSRF flagship targets. This is a MOCK service inside the docker
# network. The backend PINS this address to the mock and refuses any other
# link-local address, so a real cloud metadata endpoint can never be reached.
METADATA_MOCK_HOST=metadata
METADATA_MOCK_IP=169.254.169.254

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=5173
# Base URL the SPA uses to reach the API (same host, mapped port).
VITE_API_BASE=http://localhost:4000
# Hardcoded "analytics" key shipped in the JS bundle (info-disclosure lab).
VITE_ANALYTICS_KEY=sh_live_pk_9f2b7c1e5a4d0e8f_TRAININGONLY
